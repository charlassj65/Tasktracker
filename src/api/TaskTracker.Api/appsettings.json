{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=tasks.db"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AiProvider": {
    "Type": "Simple",
    "ApiKey": "",
    "Model": "",
    "Endpoint": ""
  },
  "AllowedHosts": "*"
}
